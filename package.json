{
	"name": "launchgate",
	"version": "0.2.0",
	"description": "A launch-gate library: hide work in progress, kill a shipped feature, no platform required.",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./next": {
			"types": "./dist/next/index.d.ts",
			"import": "./dist/next/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"check": "tsc --noEmit && vitest run && tsup",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"tsup": "^8.5.0",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4",
		"next": "^16.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"@types/react": "^19.0.0"
	},
	"packageManager": "pnpm@10.29.2",
	"peerDependencies": {
		"next": ">=15"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		}
	}
}
